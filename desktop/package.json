{
  "name": "aster-desktop",
  "productName": "Aster",
  "version": "5.3.1",
  "description": "Aster desktop app: your IGCSE planner, notes, papers and AI tutor in their own window.",
  "author": "Aster",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.mjs",
    "start": "node prepare.mjs && electron .",
    "dist:win": "node prepare.mjs && electron-builder --win",
    "dist:mac": "node prepare.mjs && electron-builder --mac",
    "dist:linux": "node prepare.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.aster.study",
    "productName": "Aster",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "tablet.html",
      "bundle/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aster",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "ffmpeg-static": "^5.2.0"
  }
}